  m_Name: ItemDescription_pl-PL
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl-PL
  m_SharedData: {fileID: 11400000, guid: 5516570f8e6cfeb41b5473f2c1ead45d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 50997837824
    m_Localized: "Zwyk\u0142a Zabawka Dla Dzieci"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197952
    m_Localized: Chroni Przed Deszczem. Ledwie
    m_Metadata:
      m_Items: []
  - m_Id: 51027197953
    m_Localized: "S\u0105 Na Nim \u015Alady Krwi"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197954
    m_Localized: "\u015Amieci Dla Czarodziej\xF3w, Skarb Dla Ciebie"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197955
    m_Localized: "Spodnie, Kt\xF3re Nosi\u0142 Tw\xF3j Wujek"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197956
    m_Localized: "Niewygodne, Ale Przynajmniej \u0179le Wykonane"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197957
    m_Localized: Podpala Wszystko Na Swojej Drodze
    m_Metadata:
      m_Items: []
  - m_Id: 51027197958
    m_Localized: "Magiczna Maska Ukryje Twoj\u0105 Twarz"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197959
    m_Localized: "Ubranie Ka\u017Cdego Szanuj\u0105cego Si\u0119 Czarodzieja"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197960
    m_Localized: "Prawdziwy Skarb Z Ukryt\u0105 Moc\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197961
    m_Localized: Przynajmniej Nie Zmarzniesz
    m_Metadata:
      m_Items: []
  - m_Id: 51027197962
    m_Localized: "Nie Ruszaj Si\u0119 Nigdzie Bez But\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197963
    m_Localized: "Przydatny Nie Tylko Do R\u0105bania Drewna"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197964
    m_Localized: Nie Wytrzyma Zimna
    m_Metadata:
      m_Items: []
  - m_Id: 51027197965
    m_Localized: "Ta Zbroja Raczej Nie Zapewni Ci Ciep\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197966
    m_Localized: "Zimny Jak Serce Jego W\u0142a\u015Bciciela"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197967
    m_Localized: "Mo\u017Ce Ci By\u0107 Zimno, Ale Przynajmniej Odci\u0105\u017Cysz
      Si\u0119 Od Obra\u017Ce\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197968
    m_Localized: Z Czystego Lodu
    m_Metadata:
      m_Items: []
  - m_Id: 51027197969
    m_Localized: "Ostrze, Kt\xF3rego Nikt Nie Zobaczy"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197970
    m_Localized: "Skutecznie Ukryje Twoj\u0105 To\u017Csamo\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197971
    m_Localized: "Zaskakuj\u0105co Lekki"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197972
    m_Localized: "Obdarzony Wielk\u0105 Moc\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197973
    m_Localized: "Nawet Ty Nie Mo\u017Cesz Tego Przebi\u0107 Ostrzem"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197974
    m_Localized: "Upewni\u0105 Si\u0119, \u017Be Nikt Ci\u0119 Nie Us\u0142yszy"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392256
    m_Localized: "Lepsze Ni\u017C R\u0119ka. Zaufaj Mi"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392257
    m_Localized: "Noktowizor, Termowizja - Dost\u0119pne S\u0105 Wszystkie Opcje"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392258
    m_Localized: "Chroni Nawet Przed Broni\u0105 Paln\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392259
    m_Localized: "Zwi\u0119ksz Swoje Mo\u017Cliwo\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392260
    m_Localized: "Idealny Do Przechowywania \u017Beton\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392261
    m_Localized: "Nigdy Wcze\u015Bniej Nie Porusza\u0142e\u015B Si\u0119 Tak Szybko"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392262
    m_Localized: "Kij Zaostrzony Na Ko\u0144cu. Klasyczny"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392263
    m_Localized: Maska Wstydu Plemienia Ngolo
    m_Metadata:
      m_Items: []
  - m_Id: 51031392264
    m_Localized: "Duch Tego Zwierz\u0119cia Daje Ci Moc"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392265
    m_Localized: "Do\u015B\u0107 G\u0142o\u015Bno Szcz\u0119ka Z\u0119bami"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392266
    m_Localized: "Obejmuje To, Co Najwa\u017Cniejsze"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392267
    m_Localized: "Przynajmniej Piasek Nie Poparzy St\xF3p"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392268
    m_Localized: Pokroi Wroga Na Plasterki
    m_Metadata:
      m_Items: []
  - m_Id: 51031392269
    m_Localized: "Bez Tego Nikt Ci\u0119 Nie Pozna"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392270
    m_Localized: "Ka\u017Cdy Mo\u017Ce Podziwia\u0107 Twoj\u0105 Klatk\u0119 Piersiow\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392271
    m_Localized: "Ma Go Ka\u017Cdy Szanuj\u0105cy Si\u0119 Pirat"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392272
    m_Localized: "Chroni\u0105 Przed Burzow\u0105 Pogod\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392273
    m_Localized: "Nie Po\u015Blizgniesz Si\u0119 Na Pok\u0142adzie"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392274
    m_Localized: "Zmoczysz Wszystkich Wrog\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392275
    m_Localized: "Czy To By\u0142 Kapelusz Niewidzialno\u015Bci?"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392276
    m_Localized: "Za\u0142o\u017Cymy Si\u0119, \u017Be Nikt Takiego Nie Ma"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392277
    m_Localized: '  +5 Do Klimatu'
    m_Metadata:
      m_Items: []
  - m_Id: 51031392278
    m_Localized: "S\u0105 Niezatapialne. Obiecujemy"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392279
    m_Localized: "\u017Bebro"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392280
    m_Localized: "R\xF3wnie Niebezpieczna, Co Tajemnicza"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392281
    m_Localized: "Zakryje Twoj\u0105 Bosk\u0105 Twarz"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392282
    m_Localized: "Twoje Wn\u0119trzno\u015Bci S\u0105 Bezpieczne"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392283
    m_Localized: "Zgodzicie Si\u0119, \u017Be Wygl\u0105daj\u0105 Niesamowicie?"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392284
    m_Localized: "Tak Lekki, \u017Be Go Nie Poczujesz"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392285
    m_Localized: "Zabior\u0105 Ci\u0119 Daleko"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586560
    m_Localized: Wspaniale!
    m_Metadata:
      m_Items: []
  - m_Id: 51035586561
    m_Localized: "To Nie Zrobi Z Ciebie \u015Awi\u0119tego"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586562
    m_Localized: "Orygina\u0142 Z Czas\xF3w Cezara"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586563
    m_Localized: "Wcale Nie Taki Nieosi\u0105galny"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586564
    m_Localized: "\u017Baden Pilum Ci\u0119 Nie Przera\u017Ca"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586565
    m_Localized: "Przejdziesz Setki Kilometr\xF3w"
    m_Metadata:
      m_Items: []
  references:
    version: 1
