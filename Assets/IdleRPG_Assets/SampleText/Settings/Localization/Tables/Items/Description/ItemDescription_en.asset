  m_TableData:
  - m_Id: 50997837824
    m_Localized: Ordinary Children's Toy
    m_Metadata:
      m_Items: []
  - m_Id: 51027197952
    m_Localized: Protects Against Rain. Barely
    m_Metadata:
      m_Items: []
  - m_Id: 51027197953
    m_Localized: There Are Traces Of Blood On It
    m_Metadata:
      m_Items: []
  - m_Id: 51027197954
    m_Localized: Trash For Wizards, Treasure For You
    m_Metadata:
      m_Items: []
  - m_Id: 51027197955
    m_Localized: Pants Your Uncle Used To Wear
    m_Metadata:
      m_Items: []
  - m_Id: 51027197956
    m_Localized: Inconvenient, But At Least Poorly Made
    m_Metadata:
      m_Items: []
  - m_Id: 51027197957
    m_Localized: Ignites Everything In Its Path
    m_Metadata:
      m_Items: []
  - m_Id: 51027197958
    m_Localized: The Magic Mask Will Hide Your Face
    m_Metadata:
      m_Items: []
  - m_Id: 51027197959
    m_Localized: The Clothes Of Any Self-respecting Wizard
    m_Metadata:
      m_Items: []
  - m_Id: 51027197960
    m_Localized: A Real Treasure With Hidden Power
    m_Metadata:
      m_Items: []
  - m_Id: 51027197961
    m_Localized: At Least You Won't Get Cold
    m_Metadata:
      m_Items: []
  - m_Id: 51027197962
    m_Localized: Don't Go Anywhere Without Shoes
    m_Metadata:
      m_Items: []
  - m_Id: 51027197963
    m_Localized: 'Useful Not Only For Wood Chopping '
    m_Metadata:
      m_Items: []
  - m_Id: 51027197964
    m_Localized: It Won't Hold Any Cold
    m_Metadata:
      m_Items: []
  - m_Id: 51027197965
    m_Localized: This Armor Is Unlikely To Keep You Warm
    m_Metadata:
      m_Items: []
  - m_Id: 51027197966
    m_Localized: Cold As Its Owner's Heart
    m_Metadata:
      m_Items: []
  - m_Id: 51027197967
    m_Localized: You May Be Cold, But At Least It'll Take Some Damage Off You
    m_Metadata:
      m_Items: []
  - m_Id: 51027197968
    m_Localized: Made Of Pure Ice
    m_Metadata:
      m_Items: []
  - m_Id: 51027197969
    m_Localized: A Blade No One Will See
    m_Metadata:
      m_Items: []
  - m_Id: 51027197970
    m_Localized: It Will Effectively Hide Your Identity
    m_Metadata:
      m_Items: []
  - m_Id: 51027197971
    m_Localized: Surprisingly Light
    m_Metadata:
      m_Items: []
  - m_Id: 51027197972
    m_Localized: Endowed With Great Power
    m_Metadata:
      m_Items: []
  - m_Id: 51027197973
    m_Localized: Even You Can't Pierce It With A Blade
    m_Metadata:
      m_Items: []
  - m_Id: 51027197974
    m_Localized: They'll Make Sure No One Hears You
    m_Metadata:
      m_Items: []
  - m_Id: 51031392256
    m_Localized: Better Than A Hand. Trust Me
    m_Metadata:
      m_Items: []
  - m_Id: 51031392257
    m_Localized: Night Vision, Thermovision - All Options Are Available
    m_Metadata:
      m_Items: []
  - m_Id: 51031392258
    m_Localized: It Even Protects Against Firearms
    m_Metadata:
      m_Items: []
  - m_Id: 51031392259
    m_Localized: Increase Your Capabilities
    m_Metadata:
      m_Items: []
  - m_Id: 51031392260
    m_Localized: Perfect For Holding Your Chips
    m_Metadata:
      m_Items: []
  - m_Id: 51031392261
    m_Localized: You've Never Moved So Fast Before
    m_Metadata:
      m_Items: []
  - m_Id: 51031392262
    m_Localized: Stick Sharpened At The End. Classic
    m_Metadata:
      m_Items: []
  - m_Id: 51031392263
    m_Localized: Shamage Mask Of The Ngolo Tribe
    m_Metadata:
      m_Items: []
  - m_Id: 51031392264
    m_Localized: The Spirit Of This Animal Gives You Power
    m_Metadata:
      m_Items: []
  - m_Id: 51031392265
    m_Localized: Chatters Its Teeth Rather Loudly
    m_Metadata:
      m_Items: []
  - m_Id: 51031392266
    m_Localized: It Covers What Is Most Important
    m_Metadata:
      m_Items: []
  - m_Id: 51031392267
    m_Localized: At Least The Sand Will Not Burn Your Feet
    m_Metadata:
      m_Items: []
  - m_Id: 51031392268
    m_Localized: It Will Cut The Enemy Into Slices
    m_Metadata:
      m_Items: []
  - m_Id: 51031392269
    m_Localized: No One Will Know You Without It
    m_Metadata:
      m_Items: []
  - m_Id: 51031392270
    m_Localized: Everyone Can Admire Your Chest
    m_Metadata:
      m_Items: []
  - m_Id: 51031392271
    m_Localized: Every Self-respecting Pirate Has It
    m_Metadata:
      m_Items: []
  - m_Id: 51031392272
    m_Localized: They Protect Against Stormy Weather
    m_Metadata:
      m_Items: []
  - m_Id: 51031392273
    m_Localized: You Won't Slip On Board
    m_Metadata:
      m_Items: []
  - m_Id: 51031392274
    m_Localized: You Will Wet All Enemies
    m_Metadata:
      m_Items: []
  - m_Id: 51031392275
    m_Localized: Was It The Hat Of Invisibility?
    m_Metadata:
      m_Items: []
  - m_Id: 51031392276
    m_Localized: We Bet That Nobody Has Such
    m_Metadata:
      m_Items: []
  - m_Id: 51031392277
    m_Localized: ' +5 To Climate'
    m_Metadata:
      m_Items: []
  - m_Id: 51031392278
    m_Localized: They Are Unsinkable. We Promise
    m_Metadata:
      m_Items: []
  - m_Id: 51031392279
    m_Localized: Ribbit
    m_Metadata:
      m_Items: []
  - m_Id: 51031392280
    m_Localized: As Dangerous As Mysterious
    m_Metadata:
      m_Items: []
  - m_Id: 51031392281
    m_Localized: It Will Cover Your Divine Face
    m_Metadata:
      m_Items: []
  - m_Id: 51031392282
    m_Localized: Your Insides Are Safe
    m_Metadata:
      m_Items: []
  - m_Id: 51031392283
    m_Localized: Do You Agree That They Look Amazing?
    m_Metadata:
      m_Items: []
  - m_Id: 51031392284
    m_Localized: So Light You Won't Feel It
    m_Metadata:
      m_Items: []
  - m_Id: 51031392285
    m_Localized: They Will Take You Far
