  m_TableData:
  - m_Id: 50997837824
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0414\u0435\u0442\u0441\u043A\u0430\u044F
      \u0418\u0433\u0440\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197952
    m_Localized: "\u0417\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u041E\u0442 \u0414\u043E\u0436\u0434\u044F.
      \u0415\u0434\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197953
    m_Localized: "\u041D\u0430 \u041D\u0435\u043C \u0421\u043B\u0435\u0434\u044B
      \u041A\u0440\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197954
    m_Localized: "\u041C\u0443\u0441\u043E\u0440 \u0414\u043B\u044F \u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A\u043E\u0432,
      \u0421\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435 \u0414\u043B\u044F \u0412\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197955
    m_Localized: "\u0411\u0440\u044E\u043A\u0438, \u041A\u043E\u0442\u043E\u0440\u044B\u0435
      \u041D\u043E\u0441\u0438\u043B \u0422\u0432\u043E\u0439 \u0414\u044F\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197956
    m_Localized: "\u041D\u0435\u0443\u0434\u043E\u0431\u043D\u043E, \u041D\u043E
      \u041A\u0430\u043A \u041C\u0438\u043D\u0438\u043C\u0443\u043C \u041F\u043B\u043E\u0445\u043E
      \u0421\u0434\u0435\u043B\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197957
    m_Localized: "\u0417\u0430\u0436\u0438\u0433\u0430\u0435\u0442 \u0412\u0441\u0435
      \u041D\u0430 \u0421\u0432\u043E\u0435\u043C \u041F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197958
    m_Localized: "\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F \u041C\u0430\u0441\u043A\u0430
      \u0421\u043A\u0440\u043E\u0435\u0442 \u0422\u0432\u043E\u0435 \u041B\u0438\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197959
    m_Localized: "\u041E\u0434\u0435\u0436\u0434\u0430 \u041B\u044E\u0431\u043E\u0433\u043E
      \u0423\u0432\u0430\u0436\u0430\u044E\u0449\u0435\u0433\u043E \u0421\u0435\u0431\u044F
      \u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197960
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0421\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435
      \u0421\u043E \u0421\u043A\u0440\u044B\u0442\u043E\u0439 \u0421\u0438\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197961
    m_Localized: "\u041F\u043E \u041A\u0440\u0430\u0439\u043D\u0435\u0439 \u041C\u0435\u0440\u0435,
      \u0412\u044B \u041D\u0435 \u041F\u0440\u043E\u0441\u0442\u0443\u0434\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197962
    m_Localized: "\u041D\u0438\u043A\u0443\u0434\u0430 \u041D\u0435 \u0425\u043E\u0434\u0438\u0442\u0435
      \u0411\u0435\u0437 \u041E\u0431\u0443\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197963
    m_Localized: "\u041F\u043E\u043B\u0435\u0437\u043D\u043E \u041D\u0435 \u0422\u043E\u043B\u044C\u043A\u043E
      \u0414\u043B\u044F \u0420\u0443\u0431\u043A\u0438 \u0414\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197964
    m_Localized: "\u041E\u043D \u041D\u0435 \u0412\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0425\u043E\u043B\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197965
    m_Localized: "\u042D\u0442\u0430 \u0411\u0440\u043E\u043D\u044F \u0412\u0440\u044F\u0434
      \u041B\u0438 \u0421\u043E\u0433\u0440\u0435\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197966
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u043E, \u041A\u0430\u043A
      \u0421\u0435\u0440\u0434\u0446\u0435 \u0415\u0433\u043E \u0412\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197967
    m_Localized: "\u0412\u0430\u043C \u041C\u043E\u0436\u0435\u0442 \u0411\u044B\u0442\u044C
      \u0425\u043E\u043B\u043E\u0434\u043D\u043E, \u041D\u043E, \u041F\u043E \u041A\u0440\u0430\u0439\u043D\u0435\u0439
      \u041C\u0435\u0440\u0435, \u042D\u0442\u043E \u0421\u043D\u0438\u043C\u0435\u0442
      \u0421 \u0412\u0430\u0441 \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0423\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 51027197968
    m_Localized: "\u0418\u0437 \u0427\u0438\u0441\u0442\u043E\u0433\u043E \u041B\u044C\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197969
    m_Localized: "\u041B\u0435\u0437\u0432\u0438\u0435 \u041D\u0438\u043A\u0442\u043E
      \u041D\u0435 \u0423\u0432\u0438\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197970
    m_Localized: "\u042D\u0442\u043E \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
      \u0421\u043A\u0440\u043E\u0435\u0442 \u0412\u0430\u0448\u0443 \u041B\u0438\u0447\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197971
    m_Localized: "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u041B\u0435\u0433\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197972
    m_Localized: "\u041D\u0430\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0439 \u0411\u043E\u043B\u044C\u0448\u043E\u0439
      \u0421\u0438\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197973
    m_Localized: "\u0414\u0430\u0436\u0435 \u041B\u0435\u0437\u0432\u0438\u0435\u043C
      \u041D\u0435 \u041F\u0440\u043E\u0442\u043A\u043D\u0435\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 51027197974
    m_Localized: "\u041E\u043D\u0438 \u041F\u043E\u0437\u0430\u0431\u043E\u0442\u044F\u0442\u0441\u044F
      \u041E \u0422\u043E\u043C, \u0427\u0442\u043E\u0431\u044B \u0412\u0430\u0441
      \u041D\u0438\u043A\u0442\u043E \u041D\u0435 \u0423\u0441\u043B\u044B\u0448\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392256
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u0420\u0443\u043A\u0438. \u041F\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u041C\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392257
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0435 \u0412\u0438\u0434\u0435\u043D\u0438\u0435,
      \u0422\u0435\u043F\u043B\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0435 -
      \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0412\u0441\u0435 \u041E\u043F\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392258
    m_Localized: "\u0417\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0414\u0430\u0436\u0435
      \u041E\u0442 \u041E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u041E\u0440\u0443\u0436\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 51031392259
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u044C\u0442\u0435 \u0421\u0432\u043E\u0438
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392260
    m_Localized: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0414\u043B\u044F \u0425\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0412\u0430\u0448\u0438\u0445
      \u0427\u0438\u043F\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392261
    m_Localized: "\u0412\u044B \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u041D\u0435
      \u0414\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u0422\u0430\u043A \u0411\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392262
    m_Localized: "\u041F\u0430\u043B\u043A\u0430 \u0417\u0430\u0442\u043E\u0447\u0435\u043D\u0430
      \u041D\u0430 \u041A\u043E\u043D\u0446\u0435. \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392263
    m_Localized: "\u041F\u043E\u0437\u043E\u0440\u043D\u0430\u044F \u041C\u0430\u0441\u043A\u0430
      \u041F\u043B\u0435\u043C\u0435\u043D\u0438 \u041D\u0433\u043E\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392264
    m_Localized: "\u0414\u0443\u0445 \u042D\u0442\u043E\u0433\u043E \u0416\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E
      \u0414\u0430\u0435\u0442 \u0412\u0430\u043C \u0421\u0438\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392265
    m_Localized: "\u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0413\u0440\u043E\u043C\u043A\u043E
      \u0421\u0442\u0443\u0447\u0438\u0442 \u0417\u0443\u0431\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392266
    m_Localized: "\u041E\u043D \u041E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0421\u0430\u043C\u043E\u0435 \u0412\u0430\u0436\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392267
    m_Localized: "\u0425\u043E\u0442\u044C \u041F\u0435\u0441\u043E\u043A \u041D\u043E\u0433\u0438
      \u041D\u0435 \u041E\u0431\u043E\u0436\u0436\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392268
    m_Localized: "\u041E\u043D \u041F\u043E\u0440\u0435\u0436\u0435\u0442 \u0412\u0440\u0430\u0433\u0430
      \u041D\u0430 \u041B\u043E\u043C\u0442\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392269
    m_Localized: "\u0411\u0435\u0437 \u041D\u0435\u0433\u043E \u0422\u0435\u0431\u044F
      \u041D\u0438\u043A\u0442\u043E \u041D\u0435 \u0423\u0437\u043D\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392270
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u041C\u043E\u0436\u0435\u0442
      \u041B\u044E\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0422\u0432\u043E\u0435\u0439
      \u0413\u0440\u0443\u0434\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392271
    m_Localized: "\u041E\u043D \u0415\u0441\u0442\u044C \u0423 \u041A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0423\u0432\u0430\u0436\u0430\u044E\u0449\u0435\u0433\u043E \u0421\u0435\u0431\u044F
      \u041F\u0438\u0440\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 51031392272
    m_Localized: "\u041E\u043D\u0438 \u0417\u0430\u0449\u0438\u0449\u0430\u044E\u0442
      \u041E\u0442 \u041D\u0435\u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392273
    m_Localized: "\u0412\u044B \u041D\u0435 \u041F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0435\u0442\u0435\u0441\u044C
      \u041D\u0430 \u0411\u043E\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392274
    m_Localized: "\u0422\u044B \u041D\u0430\u043C\u043E\u0447\u0438\u0448\u044C \u0412\u0441\u0435\u0445
      \u0412\u0440\u0430\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392275
    m_Localized: "\u042D\u0442\u043E \u0411\u044B\u043B\u0430 \u0428\u043B\u044F\u043F\u0430-\u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392276
    m_Localized: "\u0421\u043F\u043E\u0440\u0438\u043C, \u0427\u0442\u043E \u041D\u0438
      \u0423 \u041A\u043E\u0433\u043E \u041D\u0435\u0442 \u0422\u0430\u043A\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392277
    m_Localized: "  +5 \u041A \u041A\u043B\u0438\u043C\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392278
    m_Localized: "\u041E\u043D\u0438 \u041D\u0435\u043F\u043E\u0442\u043E\u043F\u043B\u044F\u0435\u043C\u044B.
      \u041C\u044B \u041E\u0431\u0435\u0449\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392279
    m_Localized: "\u0420\u0435\u0431\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392280
    m_Localized: "\u0422\u0430\u043A \u0416\u0435 \u041E\u043F\u0430\u0441\u0435\u043D,
      \u041A\u0430\u043A \u0418 \u0417\u0430\u0433\u0430\u0434\u043E\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392281
    m_Localized: "\u041E\u043D \u041F\u043E\u043A\u0440\u043E\u0435\u0442 \u0412\u0430\u0448\u0435
      \u0411\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u041B\u0438\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392282
    m_Localized: "\u0412\u0430\u0448\u0438 \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0412 \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392283
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u044B \u041B\u0438 \u0412\u044B,
      \u0427\u0442\u043E \u041E\u043D\u0438 \u0412\u044B\u0433\u043B\u044F\u0434\u044F\u0442
      \u041F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392284
    m_Localized: "\u0422\u0430\u043A \u0421\u0432\u0435\u0442\u043B\u043E, \u0427\u0442\u043E
      \u0422\u044B \u041D\u0435 \u041F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 51031392285
    m_Localized: "\u041E\u043D\u0438 \u0423\u0432\u0435\u0434\u0443\u0442 \u0412\u0430\u0441
      \u0414\u0430\u043B\u0435\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 51035586560
    m_Localized: "\u041A\u0440\u0443\u0442\u043E!"
    m_Metadata:
      m_Items: []
