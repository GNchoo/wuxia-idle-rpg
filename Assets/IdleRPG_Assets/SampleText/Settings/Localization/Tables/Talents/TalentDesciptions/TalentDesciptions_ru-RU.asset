    m_Metadata:
      m_Items: []
  - m_Id: 73508667394
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043E\u043A \u043E\u0442 \u0431\u043E\u0441\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 73508667395
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0445\u043E\u0434 \u043E\u0442 \u0432\u0441\u0435\u0445 \u0437\u0434\u0430\u043D\u0438\u0439
      (\u0434\u0435\u0440\u0435\u0432\u043D\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 73508667396
    m_Localized: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0433\u0435\u0440\u043E\u0435\u0432
      \u0438 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0445 \u0437\u0434\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 73508667397
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D,
      \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u043D\u044B\u0439
      {0}% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0431\u043E\u0441\u0441\u0430"
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 73512861696
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D,
      \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u043D\u044B\u0439
      {0}% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0431\u043E\u0441\u0441\u0430,
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 73512861697
    m_Localized: "\u0414\u043E\u0445\u043E\u0434 \u0431\u043E\u0441\u0441\u0430 \u0432
